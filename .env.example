# Copy to `.env` for local development. Real values belong in the Railway
# secrets, never in the repository.

# Upstream credentials. OPENAI_KEY is still read as a fallback so an existing
# deployment keeps working without renaming its variable.
OPENAI_API_KEY=""
OPENAI_ORG=""

PORT=3000
NODE_ENV=development

# Comma-separated allowlist. There is no wildcard default on purpose: an open
# proxy in front of a paid key is a bill anyone can run up.
ALLOWED_ORIGINS="http://localhost:5173"

# Models this proxy will forward, and the one used when a request omits it.
ALLOWED_MODELS="gpt-4o-mini,gpt-4o"
DEFAULT_MODEL="gpt-4o-mini"

# Server-side ceiling, applied whatever the caller asks for.
MAX_TOKENS_LIMIT=2048

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_BODY_BYTES=131072
